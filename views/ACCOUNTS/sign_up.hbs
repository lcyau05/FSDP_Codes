<style>
    /* Add your CSS styles here */
    .container-fluid {
        text-align: center;
    }

    label.gender,
    input[type="radio"] {
        display: inline-block;
        margin-right: 10px;
        /* Adjust spacing as needed */
    }

    .column {
        display: inline-block;
        vertical-align: top;
        margin: 10px;
        width: 45%;
    }

    label,
    input {
        display: block;
        margin: auto;
        text-align: left;
        width: 90%;
        /* Adjust the width as needed */
    }

    .button {
        display: block;
        margin: 0 auto;
    }

    .error-message {
        color: red;
        font-weight: bold;
    }
</style>
<script>
    $(document).ready(function () {
        $('#password').on('input', function () {
            var password = $(this).val();
            // Length check
            if (password.length >= 8 && password.length <= 25) {
                $('#lengthCheck').css('color', 'green');
            } else {
                $('#lengthCheck').css('color', 'red');
            }
            // Special character check
            if (/[~*&^%$#@!]+/.test(password)) {
                $('#specialCharCheck').css('color', 'green');
            } else {
                $('#specialCharCheck').css('color', 'red');
            }
            // Case check
            if (/[A-Z]/.test(password) && /[a-z]/.test(password)) {
                $('#caseCheck').css('color', 'green');
            } else {
                $('#caseCheck').css('color', 'red');
            }
        });
    });
</script>

<div class="container-fluid bg-light about py-5">
    <h1>JourneyJunction</h1>
    <form action="/sign_up" method="post">
        <div class="about-item-content bg-white rounded p-5 h-100">
            <h2 name="sign_up">Sign Up</h2><br>


            <div class="row">
                <div class="column">
                    <label for="user_name">User's Name:</label>
                    <input type="text" id="user_name" name="user_name" class="form-control" required><br><br>

                    <label for="travel_doc_id">Travel Document ID:</label>
                    <input type="text" id="travel_doc_id" name="travel_doc_id" class="form-control"
                        value="{{travel_doc_id}}" required><br><br>

                    <label for="DOB">Date of Birth:</label>
                    <input type="date" id="DOB" name="DOB" class="form-control" value="{{DOB}}" required><br><br>

                    <label for="email">Email:</label>
                    <input type="email" id="email" name="email" class="form-control" value="{{email}}" required><br><br>

                    <label for="password">Password:</label>
                    <input type="password" id="password" name="password" class="form-control" value="{{password}}"
                        required>

                    <div id="passwordGuidelines">
                        <p id="lengthCheck">• 8-25 characters long</p>
                        <p id="specialCharCheck">• Contain special characters (E.g. ~*&^%$#@!)</p>
                        <p id="caseCheck">• Contain 1 uppercase & 1 lowercase character</p>
                    </div>
                </div>
                <div class="column">

                    <label for="gender">Gender:</label>
                    <input type="radio" id="male" name="gender" value="Male" value="{{Male}}">
                    <label for="male">Male</label>
                    <input type="radio" id="female" name="gender" value="Female" value="{{Female}}">
                    <label for="female">Female</label><br><br>

                    <label for="phone_no">Phone No:</label>
                    <input type="text" id="phone_no" name="phone_no" class="form-control" value="{{phone_no}}"
                        required><br><br>

                    <label for="postal_code">Postal Code:</label>
                    <input type="text" id="postal_code" name="postal_code" class="form-control" value="{{postal_code}}"
                        required><br><br>

                    <label for="address">Address:</label>
                    <input type="text" id="address" name="address" class="form-control" value="{{address}}"
                        required><br><br>

                    <label for="confirm_password">Confirm Password:</label>
                    <input type="password" id="confirm_password" name="confirm_password" class="form-control"
                        value="{{confirm_password}}" required><br><br>

                </div>
            </div>
            {{#if errors.length}}
            <script>
                window.onload = function () {
                    var errors = {{ json errors }};
                var messages = errors.map(error => error.text);
                if (messages.length > 0) {
                    alert(messages.join('\n'));
                }
        };
            </script>
            <div>

                {{#each errors}}
                <p class="error-message">{{this.text}}</p>
                {{/each}}
            </div>
            {{/if}}
            <button type="submit">Sign Up</button>
        </div>
    </form>
</div>