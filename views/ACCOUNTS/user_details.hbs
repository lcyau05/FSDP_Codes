{{#if user}}
<h2>User Details Page</h2><br>
<div style="height: 400px; width: 90%;">
    <div class="card rounded-3 mb-4" style="width: 90%;">
        <div class="card-body p-4">
            <div class="row d-flex justify-content-between align-items-center">
                <div class="col-md-6 col-lg-6 col-xl-6">
                    <h4>User's Name: {{user_name}}</h4>
                    <h4>Gender: {{gender}}</h4>
                    <h4>Travel Document ID : {{travel_doc_id}}</h4>
                    <h4>Phone No: {{phone_no}}</h4>
                    <h4>Postal Code: {{postal_code}}</h4>
                    <a href="/logout" class="btn">Logout</a>
                </div>
                <div class="col-md-6 col-lg-6 col-xl-6">
                    <h4>User Role: {{role}}</h4>
                    <h4>Date Of Birth: {{formatDate DOB 'DD MMM YYYY'}}</h4>
                    <h4>Email: {{email}}</h4>
                    <h4>Address: {{address}}</h4>
                    <a href="/user_update" class="btn">Update Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>
{{/if}}